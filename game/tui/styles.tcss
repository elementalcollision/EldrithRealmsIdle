Screen {
    background: $background;
}

#status-bar {
    height: 5;
    border: round $primary;
    padding: 0 1;
}

#status-line {
    height: 1;
}

#log {
    height: 6;
    border: round $accent;
    padding: 0 1;
}

#log-content {
    height: 100%;
    overflow-y: auto;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

.tab-body {
    height: 1fr;
}

.tab-table {
    width: 3fr;
    height: 1fr;
}

.tab-detail-scroll {
    width: 2fr;
    height: 1fr;
    border: round $accent;
    padding: 0 1;
    margin-left: 1;
}

.tab-detail {
    height: auto;
    width: 1fr;
}

DataTable {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

.tab-help {
    height: 1;
    color: $text-muted;
    padding: 0 1;
    text-style: italic;
}
